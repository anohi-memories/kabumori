{
  "expo": {
    "name": "Social Operations",
    "slug": "kabumori-social-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "kabumori-social",
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "素材BOXに保存する画像・動画を選ぶために、写真へのアクセスを使います。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/with-ios27-scene.plugin.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "usesAppleSignIn": true
    }
  }
}
