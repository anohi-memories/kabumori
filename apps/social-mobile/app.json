{
  "expo": {
    "name": "Social Operations",
    "slug": "kabumori-social-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "kabumori-social",
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-apple-authentication",
      "./plugins/with-ios27-scene.plugin.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "usesAppleSignIn": true
    }
  }
}
