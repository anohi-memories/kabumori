EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Keep mock data until schema/RLS ownership is verified end-to-end.
EXPO_PUBLIC_DATA_SOURCE=mock
# Auth methods configured for this build (comma separated: email,x,google,apple,apple_web).
# Only list a method after its console/device gate is done; unset = email only.
EXPO_PUBLIC_AUTH_PROVIDERS=email
# Privacy policy / terms / support shown in the app (https only; leave empty until the real page exists).
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
# In-app account deletion. Set to true only after the social-mobile-account-delete
# function and its migration are independently reviewed, applied and deployed.
EXPO_PUBLIC_ACCOUNT_DELETION_ENABLED=
